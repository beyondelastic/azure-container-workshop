# Microsoft Foundry project configuration
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_MODEL_DEPLOYMENT=gpt-4.1-mini

# Azure Container Registry (set after creating ACR in lesson 01)
ACR_NAME=<your-acr-name>

# Azure resource group and location
RESOURCE_GROUP=rg-container-workshop
LOCATION=eastus2

# AKS cluster name (lesson 01)
AKS_CLUSTER_NAME=aks-triage

# AKS Automatic cluster name (lesson 05)
AKS_AUTO_CLUSTER_NAME=aks-triage-auto

# Container Apps environment name (lesson 06)
CONTAINERAPPS_ENVIRONMENT=cae-triage
